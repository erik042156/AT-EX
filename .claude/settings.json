{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify-ci-slack.sh\"",
            "async": true,
            "timeout": 3600,
            "statusMessage": "CI/CD 결과 대기 중 (Slack 알림)"
          }
        ]
      }
    ]
  }
}
